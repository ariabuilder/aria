---
/**
 * Forgot Password Page
 *
 * Request a password reset email.
 */
import "../../../styles/globals.css";
import "../../../styles/themes/aria.css";
import faviconLight from "../../../assets/favicon-light.png";
import faviconDark from "../../../assets/favicon-dark.png";
import {
  parseAcceptedLanguages,
  resolveStudioLocale,
} from "../../../../lib/localization/studioLocale";
import { getAuthDocumentTitle } from "../../../i18n/messages/domains/authDocumentTitles";

export const prerender = false;
const studioLocale = resolveStudioLocale({
  acceptedLanguages: parseAcceptedLanguages(
    Astro.request.headers.get("accept-language"),
  ),
});
---

<!doctype html>
<html
  lang={studioLocale}
  dir="ltr"
  class="theme-aria"
  data-theme="aria"
  data-aria-studio-locale={studioLocale}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{getAuthDocumentTitle(studioLocale, "auth.forgot.documentTitle")}</title>
    <script is:inline>
      (function () {
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", prefersDark);
      })();
    </script>
    <link rel="icon" href={faviconLight.src} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={faviconDark.src} media="(prefers-color-scheme: dark)" />
  </head>
  <body class="bg-background text-foreground">
    <div id="aria-auth-app" data-auth-page="forgot"></div>
    <script>
      import "../main.ts";
    </script>
  </body>
</html>
