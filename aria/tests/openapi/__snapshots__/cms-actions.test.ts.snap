                "schema": {
                  "$ref": "#/components/schemas/cms_collections_clearTemplate_output",
                },
              },
            },
            "description": "Successful Astro Action response",
          },
        },
        "summary": "Clear template routing from a collection",
        "tags": [
          "collections",
        ],
        "x-aria-transport": "astro-actions",
      },
    },
