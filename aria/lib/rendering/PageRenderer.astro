---
/**
 * Production Page Renderer with CSS Optimization
 *
 * Renders pages with generated utility classes instead of inline styles
 * for production builds to improve performance and SEO.
 */

import { generateStylesheet } from "./cssGenerator";
import type { PageDSL, BuilderNode } from "../types/nodes";
import { serializeFontFamilyValue } from "../styles/fontFamily";

type CanonicalBreakpoint = "base" | "tablet" | "desktop";

interface Props {
  dsl: PageDSL;
  mode?: "editor" | "production";
}

const { dsl, mode = "production" } = Astro.props;

// Generate stylesheet and class map for production
let stylesheet = "";
let classMap = new Map<string, string>();

if (mode === "production") {
  const generated = generateStylesheet(dsl);
  stylesheet = generated.css;
  classMap = generated.classMap;
}

/**
 * Get CSS class name for a node (production) or undefined (editor)
 */
function getClassName(node: BuilderNode): string | undefined {
  if (mode === "editor") return undefined; // Use inline styles in editor

  return classMap.get(node.id); // Use generated class in production
}

/**
 * Get inline styles for a node (editor) or undefined (production)
 */
function getInlineStyles(
  node: BuilderNode,
): Record<string, string> | undefined {
  if (mode === "production") return undefined; // Use classes in production

  // Convert StyleMap to inline styles for editor
  if (!node.styles) return undefined;

  const inlineStyles: Record<string, string> = {};

  const getResponsiveValue = (
    value: unknown,
    breakpoint: CanonicalBreakpoint,
  ): string | undefined => {
    if (typeof value === "string") {
      return value;
    }

    if (!value || typeof value !== "object") {
      return undefined;
    }

    const responsive = value as Record<string, unknown>;
    const cascade =
      breakpoint === "desktop"
        ? ["desktop", "tablet", "base"]
        : breakpoint === "tablet"
          ? ["tablet", "base"]
          : ["base"];

    for (const key of cascade) {
      const candidate = responsive[key];
      if (typeof candidate === "string") {
        return candidate;
      }
    }

    return undefined;
  };

  const withPx = (value: string | undefined): string | undefined => {
    if (!value) {
      return undefined;
    }

    const trimmed = value.trim();
    if (/^-?\d+(?:\.\d+)?$/.test(trimmed)) {
      return `${Math.round(Number(trimmed))}px`;
    }

    return trimmed;
  };

  const basePadding = withPx(getResponsiveValue(node.styles.padding, "base"));
  if (basePadding) {
    inlineStyles["padding"] = basePadding;
  }

  const baseMargin = withPx(getResponsiveValue(node.styles.margin, "base"));
  if (baseMargin) {
    inlineStyles["margin"] = baseMargin;
  }

  const baseColor = getResponsiveValue(node.styles.color, "base");
  if (baseColor) inlineStyles["color"] = baseColor;

  const baseBackground =
    getResponsiveValue(node.styles.backgroundColor, "base") ||
    getResponsiveValue(node.styles.background, "base");
  if (baseBackground) {
    inlineStyles["background"] = baseBackground;
  }

  const baseFontSize = withPx(getResponsiveValue(node.styles.fontSize, "base"));
  if (baseFontSize) {
    inlineStyles["font-size"] = baseFontSize;
  }
  const baseFontWeight = getResponsiveValue(node.styles.fontWeight, "base");
  if (baseFontWeight) {
    inlineStyles["font-weight"] = baseFontWeight;
  }
  const baseFontFamily = getResponsiveValue(node.styles.fontFamily, "base");
  if (baseFontFamily) {
    inlineStyles["font-family"] = serializeFontFamilyValue(baseFontFamily);
  }
  const baseLineHeight = getResponsiveValue(node.styles.lineHeight, "base");
  if (baseLineHeight) {
    inlineStyles["line-height"] = baseLineHeight;
  }
  const baseTextAlign = getResponsiveValue(node.styles.textAlign, "base");
  if (baseTextAlign) {
    inlineStyles["text-align"] = baseTextAlign;
  }

  const baseDisplay = getResponsiveValue(node.styles.display, "base");
  if (baseDisplay) inlineStyles["display"] = baseDisplay;

  const baseFlexDirection = getResponsiveValue(
    node.styles.flexDirection,
    "base",
  );
  if (baseFlexDirection) {
    inlineStyles["flex-direction"] = baseFlexDirection;
  }

  const baseAlignItems = getResponsiveValue(node.styles.alignItems, "base");
  if (baseAlignItems) {
    inlineStyles["align-items"] = baseAlignItems;
  }

  const baseJustifyContent = getResponsiveValue(
    node.styles.justifyContent,
    "base",
  );
  if (baseJustifyContent) {
    inlineStyles["justify-content"] = baseJustifyContent;
  }

  const baseGap = withPx(getResponsiveValue(node.styles.gap, "base"));
  if (baseGap) {
    inlineStyles["gap"] = baseGap;
  }

  const baseBorderWidth = withPx(
    getResponsiveValue(node.styles.borderWidth, "base"),
  );
  if (baseBorderWidth) {
    inlineStyles["border-width"] = baseBorderWidth;
  }

  const baseBorderStyle = getResponsiveValue(node.styles.borderStyle, "base");
  if (baseBorderStyle) {
    inlineStyles["border-style"] = baseBorderStyle;
  }

  const baseBorderColor = getResponsiveValue(node.styles.borderColor, "base");
  if (baseBorderColor) {
    inlineStyles["border-color"] = baseBorderColor;
  }

  const baseBorderRadius = withPx(
    getResponsiveValue(node.styles.borderRadius, "base"),
  );
  if (baseBorderRadius) {
    inlineStyles["border-radius"] = baseBorderRadius;
  }

  // Responsive CSS variables for editor
  const tabletPadding = withPx(
    getResponsiveValue(node.styles.padding, "tablet"),
  );
  if (tabletPadding) {
    inlineStyles["--p-tablet"] = tabletPadding;
  }

  const desktopPadding = withPx(
    getResponsiveValue(node.styles.padding, "desktop"),
  );
  if (desktopPadding) {
    inlineStyles["--p-desktop"] = desktopPadding;
  }

  const tabletFontSize = withPx(
    getResponsiveValue(node.styles.fontSize, "tablet"),
  );
  if (tabletFontSize) {
    inlineStyles["--fs-tablet"] = tabletFontSize;
  }

  const desktopFontSize = withPx(
    getResponsiveValue(node.styles.fontSize, "desktop"),
  );
  if (desktopFontSize) {
    inlineStyles["--fs-desktop"] = desktopFontSize;
  }

  return Object.keys(inlineStyles).length > 0 ? inlineStyles : undefined;
}

/**
 * Get CSS style string from object
 */
function stylesToString(styles: Record<string, string>): string {
  return Object.entries(styles)
    .map(([key, value]) => `${key}: ${value}`)
    .join("; ");
}

/**
 * Render a single node with appropriate styling
 */
function renderNodeWithStyles(node: BuilderNode) {
  const className = getClassName(node);
  const inlineStyles = getInlineStyles(node);

  let styleAttr = "";
  if (inlineStyles) {
    styleAttr = stylesToString(inlineStyles);
  }

  let classAttr = className || "";

  const editorAttrs =
    mode === "editor"
      ? {
          "data-aria-id": node.id,
          "data-aria-type": node.type,
          contenteditable: node.metadata?.editable ? "true" : "false",
        }
      : {};

  return {
    class: classAttr,
    style: styleAttr,
    ...editorAttrs,
  };
}
---

{
  mode === "production" && stylesheet && (
    <style is:inline set:html={stylesheet} />
  )
}

<!-- Render DSL nodes -->
<Fragment>
  {
    dsl.nodes.map((node) => {
      const nodeStyles = renderNodeWithStyles(node);

      // Get the component from registry
      // This is simplified - in real implementation, use BlockRegistry
      if (node.type === "Section") {
        return (
          <section
            class={nodeStyles.class}
            style={nodeStyles.style}
            data-aria-id={nodeStyles["data-aria-id"]}
            data-aria-type={nodeStyles["data-aria-type"]}
          >
            {/* Render children recursively */}
            {node.children?.map((child) => {
              const childStyles = renderNodeWithStyles(child);

              if (child.type === "Hero") {
                return (
                  <div
                    class={childStyles.class}
                    style={childStyles.style}
                    data-aria-id={childStyles["data-aria-id"]}
                    data-aria-type={childStyles["data-aria-type"]}
                  >
                    <h1>{child.props?.title || "Hero Title"}</h1>
                    <p>{child.props?.subtitle || "Hero subtitle"}</p>
                  </div>
                );
              }

              if (child.type === "Button") {
                return (
                  <button
                    class={`button ${childStyles.class}`}
                    style={childStyles.style}
                    data-aria-id={childStyles["data-aria-id"]}
                    data-aria-type={childStyles["data-aria-type"]}
                  >
                    {child.props?.text || "Button"}
                  </button>
                );
              }

              // Default wrapper for unknown types
              return (
                <div
                  class={childStyles.class}
                  style={childStyles.style}
                  data-aria-id={childStyles["data-aria-id"]}
                  data-aria-type={childStyles["data-aria-type"]}
                >
                  {child.props?.content || child.type}
                </div>
              );
            })}
          </section>
        );
      }

      // Default wrapper for top-level nodes
      return (
        <div
          class={nodeStyles.class}
          style={nodeStyles.style}
          data-aria-id={nodeStyles["data-aria-id"]}
          data-aria-type={nodeStyles["data-aria-type"]}
        >
          {node.props?.content || node.type}
        </div>
      );
    })
  }
</Fragment>
